# XIAO MG24 Zigbee RGB battery lamp: Simplicity SDK (slc) project.
# Pinned: Simplicity SDK 2026.6.1, Arm GNU Toolchain 14.2.Rel1, slc-cli 6.0.23 (see ../CLAUDE.md).
# Part (no official board definition exists for the Seeed XIAO MG24):
#   EFR32MG24B220F1536IM48, passed with `--with` at generation time.
# Every pin is set in config/app_config.h.
project_name: xiao_mg24_rgb_lamp
label: XIAO MG24 Zigbee RGB lamp
package: zigbee
category: Zigbee Application
quality: experimental
description: >
  Battery-powered Zigbee 3.0 RGB lamp (sleepy end device) for the Seeed Studio
  XIAO MG24. Phase 3: endpoint 1 is an Extended Color Light (On/Off, Level,
  Color Control XY/HS/colour temperature, Groups, Scenes, Identify) driving the
  Phase 2 lamp (TIMER0 PWM, gamma, balance, fades); last state kept in NVM3;
  bench console over SEGGER RTT; pairing / factory-reset button on D9.
  Never joins a network on its own.

sdk:
  id: simplicity_sdk
  version: 2026.6.1

component:
  - id: sl_main
  - id: sl_main_custom_main   # main() is src/main.c
  # Console and logs over SEGGER RTT, read by OpenOCD through the on-board
  # CMSIS-DAP (the link already used for flashing). No COM port or USB-serial
  # driver is needed on the PC (the operator's Windows 8.1 has none for the
  # SAMD11's CDC port). USART0 (PA08/PA09) is left unused: the SDK would pick
  # a UART over RTT as the console if both were present.
  - id: iostream_rtt
  - id: iostream_retarget_stdio
  - id: cli
    instance:
      - example
  - id: zigbee_debug_print
  - id: zigbee_pro_leaf_stack
  - id: zigbee_zcl_framework_core
  - id: zigbee_zcl_cli
  - id: zigbee_core_cli
  - id: zigbee_basic
  - id: zigbee_identify
  - id: zigbee_groups_server
  - id: zigbee_scenes
  - id: zigbee_on_off
  - id: zigbee_level_control
  - id: zigbee_color_control_server
  - id: zigbee_reporting
  - id: zigbee_end_device_support
  - id: zigbee_network_steering
  - id: zigbee_scan_dispatch
  - id: zigbee_update_tc_link_key
  - id: clock_manager
  - id: power_manager
  - id: emlib_gpio
  - id: gpio          # D9 button edge interrupt (sl_gpio_configure_external_interrupt)
  - id: emlib_timer
  - id: toolchain_gcc_lto
    condition:
      - toolchain_gcc
  # Application image for a Gecko bootloader: linked above the bootloader
  # area, so flashing it never writes the bootloader the board already has
  # (same layout as the Silicon Labs Arduino core's XIAO MG24 Zigbee variant,
  # FLASH ORIGIN 0x08006000). See ../docs/flashing.md.
  - id: zigbee_application_bootloader

configuration:
  - name: SLI_ZIGBEE_PRIMARY_NETWORK_DEVICE_TYPE
    value: SLI_ZIGBEE_NETWORK_DEVICE_TYPE_SLEEPY_END_DEVICE
  - name: SLI_ZIGBEE_PRIMARY_NETWORK_SECURITY_TYPE
    value: SLI_ZIGBEE_NETWORK_SECURITY_TYPE_3_0
  # Pairing is on demand only (`zigbee join`): no steering at start-up even if
  # some code called the autostart helper.
  - name: SL_ZIGBEE_AF_PLUGIN_NETWORK_STEERING_ENABLE_AUTOSTART
    value: 0
  # CurrentLevel 1..254 (0 would be "on but dark"; 255 is reserved in ZCL).
  - name: SL_ZIGBEE_AF_PLUGIN_LEVEL_CONTROL_MINIMUM_LEVEL
    value: 1
  - name: SL_ZIGBEE_AF_PLUGIN_LEVEL_CONTROL_MAXIMUM_LEVEL
    value: 254
  # Z2M configures reports for on/off, level, colour mode, x, y, hue,
  # saturation and colour temperature: 8 entries, plus a margin.
  - name: SL_ZIGBEE_AF_PLUGIN_REPORTING_TABLE_SIZE
    value: 12
  # Scenes are stored with the stack's tokens (NVM3 Zigbee domain), written
  # only on a "store scene" command.
  - name: SL_ZIGBEE_AF_PLUGIN_SCENES_TABLE_SIZE
    value: 8
  # Parent lost (coordinator restarted, router unplugged): keep trying to
  # rejoin, every SL_ZIGBEE_AF_PLUGIN_END_DEVICE_SUPPORT_MOVE_DELAY_SECONDS
  # (10 s), instead of giving up after 4 attempts and staying offline until
  # the next reset. 255 = never stop. Phase 5 revisits the cost on battery.
  - name: SL_ZIGBEE_AF_REJOIN_ATTEMPTS_MAX
    value: 255
  - name: SL_CLI_MAX_INPUT_ARGUMENTS
    value: 16
  - name: SL_CLI_PROMPT_STRING
    value: "\"rgb_lamp>\""
  # Keep the debug interface usable in EM2 (SDK default, stated explicitly):
  # the probe can always attach and read RTT.
  - name: SL_DEVICE_INIT_EMU_EM2_DEBUG_ENABLE
    value: 1
  # Crystals on the XIAO MG24 (schematic: X2 39 MHz, X1 32.768 kHz). Tuning
  # values from the Silicon Labs Arduino core's XIAO MG24 Zigbee variant
  # (variants/xiao_mg24/zigbee/config/sl_clock_manager_*_config.h, MIT).
  - name: SL_CLOCK_MANAGER_HFXO_EN
    value: SL_CLOCK_MANAGER_HFXO_EN_ENABLE
  - name: SL_CLOCK_MANAGER_HFXO_CTUNE
    value: 95
  - name: SL_CLOCK_MANAGER_LFXO_EN
    value: 1
  - name: SL_CLOCK_MANAGER_LFXO_CTUNE
    value: 44
  - name: SL_CLOCK_MANAGER_DEFAULT_HF_CLOCK_SOURCE
    value: SL_CLOCK_MANAGER_DEFAULT_HF_CLOCK_SOURCE_HFXO
  - name: SL_CLOCK_MANAGER_DEFAULT_LF_CLOCK_SOURCE
    value: SL_CLOCK_MANAGER_DEFAULT_LF_CLOCK_SOURCE_LFXO
  - name: NVM3_DEFAULT_NVM_SIZE
    value: 32768
  - name: SL_PSA_ITS_SUPPORT_V1_DRIVER
    value: 0
  - name: SL_PSA_ITS_SUPPORT_V2_DRIVER
    value: 0
  - name: SL_PSA_ITS_SUPPORT_V3_DRIVER
    value: 1

source:
  - path: src/main.c
  - path: src/zigbee.c
  - path: src/rgb_led.c
  - path: src/battery.c
  - path: src/power_manager.c
  - path: src/storage.c
  - path: src/lamp.c
  - path: src/lamp_cli.c
  - path: src/color.c
  - path: src/zigbee_light.c
  - path: src/zigbee_cli.c
  - path: src/button.c

include:
  - path: config
    file_list:
      - path: app_config.h
  - path: src
    file_list:
      - path: rgb_led.h
      - path: battery.h
      - path: power_manager.h
      - path: storage.h
      - path: lamp.h
      - path: lamp_cli.h
      - path: zigbee_app.h
      - path: color.h
      - path: zigbee_light.h
      - path: zigbee_cli.h
      - path: button.h

config_file:
  - path: config/zcl/zcl_config.zap
    file_id: zap_configuration_file_id
    directory: zcl

toolchain_settings: []
